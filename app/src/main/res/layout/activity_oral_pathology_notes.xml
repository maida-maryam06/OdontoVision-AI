<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#123943">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Read Oral Pathology Notes"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="These lecture PDFs are uploaded by faculty. Open any lecture to read and prepare for odontogenic oral pathology quizzes."
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faculty Uploaded Lecture PDFs"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvEmptyStudentPdfList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No lecture PDFs uploaded by faculty yet."
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="14dp"
            android:background="#22000000" />

        <LinearLayout
            android:id="@+id/studentPdfListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

    </LinearLayout>

</ScrollView>