<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#123943">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AR/3D Topic"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/tvConcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3D/AR Concept"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:background="#22000000"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAnatomy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anatomical Relationship"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:background="#22000000"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvClinical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clinical Importance"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:background="#22000000"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvFuture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Future AR Implementation"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:background="#22000000"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>