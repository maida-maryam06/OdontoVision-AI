<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#123943">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AR/3D Learning Module"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore conceptual 3D learning modules for odontogenic cysts and tumors."
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This prototype demonstrates how AR and 3D visualization can help dental students understand the spatial relationship of odontogenic lesions with teeth, jaws, and surrounding anatomical structures."
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conceptual 3D Topics"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDentigerous3D"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dentigerous Cyst 3D View"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAmeloblastoma3D"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ameloblastoma Jaw Model"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOKC3D"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OKC Mandibular Lesion"
            android:textAllCaps="false"
            android:layout_marginBottom="18dp"
            app:cornerRadius="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: This screen represents a prototype AR/3D learning module. Full AR functionality can be implemented in future using ARCore, Unity, or WebAR-based models."
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>